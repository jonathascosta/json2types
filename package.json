{
  "name": "json2types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns a JSON sample into C# and TypeScript types, in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
